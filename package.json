{
  "name": "zandronum-vscode",
  "displayName": "zandronum-vscode",
  "description": "VS Code extension for Zandronum modding — DECORATE, ACS, lump syntax, build tools, and visual editors.",
  "version": "0.0.1",
  "publisher": "zandronum",
  "engines": {
    "vscode": "^1.116.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onLanguage:decorate",
    "onLanguage:acs",
    "onLanguage:sndinfo",
    "onLanguage:textures",
    "onLanguage:sbarinfo",
    "onLanguage:cvarinfo",
    "onDebug:zandronum",
    "onCustomEditor:zandronum.spriteOffsetEditor"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "decorate",
        "aliases": [
          "DECORATE",
          "decorate"
        ],
        "extensions": [
          ".dec",
          ".decorate"
        ],
        "filenames": [
          "DECORATE"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "acs",
        "aliases": [
          "ACS",
          "acs"
        ],
        "extensions": [
          ".acs"
        ],
        "filenames": [
          "SCRIPTS"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "mapinfo",
        "aliases": [
          "MAPINFO"
        ],
        "filenames": [
          "MAPINFO"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "sndinfo",
        "aliases": [
          "SNDINFO"
        ],
        "filenames": [
          "SNDINFO"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "gldefs",
        "aliases": [
          "GLDEFS"
        ],
        "filenames": [
          "GLDEFS"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "menudef",
        "aliases": [
          "MENUDEF"
        ],
        "filenames": [
          "MENUDEF"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "textures",
        "aliases": [
          "TEXTURES"
        ],
        "filenames": [
          "TEXTURES"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "animdefs",
        "aliases": [
          "ANIMDEFS"
        ],
        "filenames": [
          "ANIMDEFS"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "sbarinfo",
        "aliases": [
          "SBARINFO"
        ],
        "filenames": [
          "SBARINFO"
        ],
        "filenamePatterns": [
          "SBARINFO.*"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "cvarinfo",
        "aliases": [
          "CVARINFO"
        ],
        "filenames": [
          "CVARINFO"
        ],
        "filenamePatterns": [
          "CVARINFO.*"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "language",
        "aliases": [
          "LANGUAGE"
        ],
        "filenames": [
          "LANGUAGE"
        ],
        "filenamePatterns": [
          "LANGUAGE.*"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "decorate",
        "scopeName": "source.decorate",
        "path": "./syntaxes/decorate.tmLanguage.json"
      },
      {
        "language": "acs",
        "scopeName": "source.acs",
        "path": "./syntaxes/acs.tmLanguage.json"
      },
      {
        "language": "mapinfo",
        "scopeName": "source.mapinfo",
        "path": "./syntaxes/mapinfo.tmLanguage.json"
      },
      {
        "language": "sndinfo",
        "scopeName": "source.sndinfo",
        "path": "./syntaxes/sndinfo.tmLanguage.json"
      },
      {
        "language": "gldefs",
        "scopeName": "source.gldefs",
        "path": "./syntaxes/gldefs.tmLanguage.json"
      },
      {
        "language": "menudef",
        "scopeName": "source.menudef",
        "path": "./syntaxes/menudef.tmLanguage.json"
      },
      {
        "language": "textures",
        "scopeName": "source.textures",
        "path": "./syntaxes/textures.tmLanguage.json"
      },
      {
        "language": "animdefs",
        "scopeName": "source.animdefs",
        "path": "./syntaxes/animdefs.tmLanguage.json"
      },
      {
        "language": "sbarinfo",
        "scopeName": "source.sbarinfo",
        "path": "./syntaxes/sbarinfo.tmLanguage.json"
      },
      {
        "language": "cvarinfo",
        "scopeName": "source.cvarinfo",
        "path": "./syntaxes/cvarinfo.tmLanguage.json"
      },
      {
        "language": "language",
        "scopeName": "source.language",
        "path": "./syntaxes/language.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "decorate",
        "path": "./snippets/decorate.snippets.json"
      },
      {
        "language": "acs",
        "path": "./snippets/acs.snippets.json"
      }
    ],
    "commands": [
      {
        "command": "acs.compile",
        "title": "Compile Current ACS",
        "category": "Zandronum"
      },
      {
        "command": "zandronum.buildProject",
        "title": "Build Project",
        "category": "Zandronum"
      },
      {
        "command": "zandronum.runProject",
        "title": "Run Project",
        "category": "Zandronum"
      },
      {
        "command": "zandronum.selectRunConfiguration",
        "title": "Select Run Configuration",
        "category": "Zandronum"
      },
      {
        "command": "decorate.buildPK3",
        "title": "Build PK3"
      },
      {
        "command": "acs.compileAllAndBuild",
        "title": "Compile All ACS and Build PK3"
      },
      {
        "command": "acs.compileCurrentAndBuild",
        "title": "Compile Current ACS and Build PK3"
      },
      {
        "command": "zandronum.run",
        "title": "Run Zandronum"
      },
      {
        "command": "zandronum.buildAndRun",
        "title": "Build and Run Zandronum"
      },
      {
        "command": "acs.compileAllBuildAndRun",
        "title": "Compile All ACS, Build and Run"
      },
      {
        "command": "zandronum.editSpriteOffset",
        "title": "Edit Sprite Offset"
      },
      {
        "command": "textures.openEditor",
        "title": "Open Texture Editor"
      },
      {
        "command": "textures.editTranslationColor",
        "title": "Edit Translation Color"
      },
      {
        "command": "decorate.previewOffset",
        "title": "Preview Weapon Offset"
      },
      {
        "command": "zandronum.addBaseResource",
        "title": "Add Base Resource"
      },
      {
        "command": "zandronum.refreshBaseResources",
        "title": "Refresh Base Resources"
      }
    ],
    "configuration": [
      {
        "title": "Zandronum",
        "order": 0,
        "properties": {
          "zandronum-vscode.accPath": {
            "type": "string",
            "default": "",
            "order": 0,
            "description": "Path to the ACC compiler executable (a leading '~' is expanded). Leave empty to use 'acc' from system PATH."
          },
          "zandronum-vscode.accIncludePaths": {
            "type": "string",
            "default": "",
            "order": 1,
            "description": "Extra ACC -i directories (semicolon-separated), applied after auto-resolved include dirs. ACC honors at most 15 -i paths (MAX_INCLUDE_PATHS 16 minus the reserved file-directory slot)."
          },
          "zandronum-vscode.zandronumPath": {
            "type": "string",
            "default": "",
            "order": 2,
            "description": "Path to the Zandronum executable (a leading '~' is expanded). Leave empty to use 'zandronum' from system PATH."
          },
          "zandronum-vscode.pk3Root": {
            "type": "string",
            "default": "src",
            "order": 3,
            "description": "PK3 content root directory relative to workspace root. Resources and ACS files inside this directory get higher lookup priority."
          },
          "zandronum-vscode.pk3LeanPack": {
            "type": "boolean",
            "default": false,
            "order": 4,
            "description": "When true, apply <pk3Root>/.pk3ignore (gitignore syntax) while packaging the PK3. When false, pack all files under pk3Root. .pk3ignore itself is never packed."
          },
          "zandronum-vscode.baseResources": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [],
            "order": 5,
            "description": "Read-only base resource paths loaded before the workspace for symbol resolution. Supports .pk3/.zip archives and directories (a leading '~' is expanded). Later entries override earlier ones; workspace always wins. .wad and .pk7 are not supported yet."
          },
          "zandronum-vscode.accOutputDir": {
            "type": "string",
            "default": "",
            "order": 6,
            "description": "Output directory for compiled .o files, relative to the workspace root. If empty, defaults to <pk3Root>/acs."
          },
          "zandronum-vscode.accConcurrency": {
            "type": "number",
            "default": 0,
            "minimum": 0,
            "order": 7,
            "description": "Max parallel ACC processes when compiling multiple ACS libraries. 0 means min(4, CPU count)."
          },
          "zandronum-vscode.textures.translationPreviewMode": {
            "type": "string",
            "enum": ["native", "viewport"],
            "enumItemLabels": ["Native color preview", "Visible region color preview"],
            "markdownEnumDescriptions": [
              "Scan the whole document. Uses native color swatches and supports the native color picker; subject to `editor.colorDecoratorsLimit`.",
              "Draw custom swatches in the visible region with bounded caching and preloading. Hover a color value and choose **Edit color** to open the custom picker; clicking the swatch does not open the native picker."
            ],
            "default": "native",
            "scope": "resource",
            "order": 8,
            "markdownDescription": "Translation color preview in TEXTURES text editors only. Both modes respect `editor.colorDecorators`. Choose viewport for large documents; its editing interaction differs from native preview."
          },
          "zandronum-vscode.playpalPath": {
            "type": "string",
            "default": "",
            "order": 9,
            "description": "Path to an external PLAYPAL lump file or directory containing one. Supports relative paths (to workspace root), absolute paths, and a leading '~'. Used for palette color preview in Translation properties."
          }
        }
      },
      {
        "title": "Zandronum › Formatting",
        "order": 1,
        "properties": {
          "zandronum-vscode.format.braceStyle": {
            "type": "string",
            "enum": ["nextLine", "sameLine"],
            "enumItemLabels": ["Next line (Allman)", "Same line"],
            "default": "nextLine",
            "scope": "language-overridable",
            "order": 0,
            "markdownDescription": "Controls brace placement for DECORATE, ACS, and SBARINFO."
          },
          "zandronum-vscode.format.spaceAfterComma": {
            "type": "boolean",
            "default": true,
            "scope": "language-overridable",
            "order": 1,
            "description": "Insert one space after commas in DECORATE and ACS."
          },
          "zandronum-vscode.decorate.format.stateLabelIndent": {
            "type": "integer",
            "default": 0,
            "minimum": 0,
            "scope": "language-overridable",
            "order": 2,
            "description": "Extra indentation for DECORATE state labels."
          },
          "zandronum-vscode.decorate.format.stateFrameIndent": {
            "type": ["integer", "null"],
            "default": null,
            "minimum": 0,
            "scope": "language-overridable",
            "order": 3,
            "description": "Extra indentation for DECORATE state frames. null uses the editor tab size."
          }
        }
      }
    ],
    "customEditors": [
      {
        "viewType": "zandronum.spriteOffsetEditor",
        "displayName": "Sprite Offset Editor",
        "selector": [
          {
            "filenamePattern": "*.png"
          }
        ],
        "priority": "option"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "decorate.buildPK3",
          "when": "false"
        },
        {
          "command": "acs.compileAllAndBuild",
          "when": "false"
        },
        {
          "command": "acs.compileCurrentAndBuild",
          "when": "false"
        },
        {
          "command": "zandronum.run",
          "when": "false"
        },
        {
          "command": "zandronum.buildAndRun",
          "when": "false"
        },
        {
          "command": "acs.compileAllBuildAndRun",
          "when": "false"
        },
        {
          "command": "textures.editTranslationColor",
          "when": "false"
        }
      ],
      "explorer/context": [
        {
          "command": "zandronum.editSpriteOffset",
          "when": "resourceExtname == .png",
          "group": "zandronum"
        }
      ],
      "editor/context": [
        {
          "command": "textures.openEditor",
          "when": "editorLangId == textures",
          "group": "textures"
        },
        {
          "command": "decorate.previewOffset",
          "when": "editorLangId == decorate",
          "group": "decorate"
        }
      ]
    },
    "configurationDefaults": {
      "[textures]": {
        "editor.colorDecoratorsLimit": 10000,
        "editor.defaultFormatter": "zandronum.zandronum-vscode"
      },
      "[decorate]": {
        "editor.colorDecoratorsLimit": 10000,
        "editor.defaultFormatter": "zandronum.zandronum-vscode"
      },
      "[acs]": {
        "editor.colorDecoratorsLimit": 10000,
        "editor.defaultFormatter": "zandronum.zandronum-vscode"
      },
      "[sbarinfo]": {
        "editor.defaultFormatter": "zandronum.zandronum-vscode"
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "inspect:pk3": "node scripts/inspect-pk3.js",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.19.17",
    "@types/vscode": "^1.116.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "eslint": "^9.39.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "ignore": "^7.0.6"
  }
}
