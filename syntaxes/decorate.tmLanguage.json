{
	"$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
	"name": "DECORATE",
	"patterns": [
		{
			"include": "#comments"
		},
		{
			"include": "#preprocessor"
		},
		{
			"include": "#actor-declaration"
		},
		{
			"include": "#states-block"
		},
		{
			"include": "#strings"
		},
		{
			"include": "#flags"
		},
		{
			"include": "#constants"
		},
		{
			"include": "#actor-properties"
		},
		{
			"include": "#action-functions"
		},
		{
			"include": "#keywords"
		},
		{
			"include": "#properties"
		},
		{
			"include": "#operators"
		},
		{
			"include": "#numbers"
		}
	],
	"repository": {
		"comments": {
			"patterns": [
				{
					"name": "comment.line.editor-key.decorate",
					"begin": "(?i)//\\$(?=Arg[0-9](?:Tooltip|Type|Enum|Default|Flags)?\\b|Category\\b|Title\\b|Sprite\\b|Color\\b|Angled\\b|NotAngled\\b|IgnoreRenderstyle\\b|Obsolete\\b|User\\b|ClearArgs\\b|GZDB_SKIP\\b|Sort(?:ed)?\\b|Arrow\\b|Error\\b|FixedSize\\b|FixedRotation\\b|AbsoluteZ\\b)",
					"end": "$",
					"beginCaptures": {
						"0": {"name": "punctuation.definition.comment.decorate"}
					},
					"patterns": [
						{
							"match": "(?i)\\G(Arg[0-9](?:Tooltip|Type|Enum|Default|Flags)?|Category|Title|Sprite|Color|Angled|NotAngled|IgnoreRenderstyle|Obsolete|User|ClearArgs|GZDB_SKIP|Sort(?:ed)?|Arrow|Error|FixedSize|FixedRotation|AbsoluteZ)\\b",
							"name": "keyword.other.editor-key.decorate"
						},
						{
							"match": "\"[^\"]*\"",
							"name": "string.quoted.double.decorate"
						},
						{
							"match": "\\S+",
							"name": "string.unquoted.editor-key.decorate"
						}
					]
				},
				{
					"name": "comment.line.double-slash.decorate",
					"match": "//.*$"
				},
				{
					"name": "comment.block.decorate",
					"begin": "/\\*",
					"end": "\\*/"
				}
			]
		},
		"preprocessor": {
			"patterns": [
				{
					"match": "#include\\b",
					"name": "keyword.control.decorate"
				}
			]
		},
		"actor-declaration": {
			"patterns": [
				{
					"name": "meta.actor.decorate",
					"match": "(?i)\\b(ACTOR)\\b(?:\\s+([a-zA-Z0-9_][a-zA-Z0-9_]*))?(?:\\s*:\\s*([a-zA-Z0-9_][a-zA-Z0-9_]*))?(?:\\s+(replaces)\\s+([a-zA-Z0-9_][a-zA-Z0-9_]*))?",
					"captures": {
						"1": {"name": "keyword.declaration.decorate"},
						"2": {"name": "entity.name.class.decorate"},
						"3": {"name": "entity.name.class.inherited.decorate"},
						"4": {"name": "keyword.other.decorate"},
						"5": {"name": "entity.name.class.inherited.decorate"}
					}
				},
				{
					"match": "(?i)\\b(replaces)\\b\\s+([a-zA-Z0-9_][a-zA-Z0-9_]*)",
					"captures": {
						"1": {"name": "keyword.other.decorate"},
						"2": {"name": "entity.name.class.inherited.decorate"}
					}
				}
			]
		},
		"states-block": {
			"patterns": [
				{
					"name": "keyword.declaration.decorate",
					"match": "(?i)\\b(States)\\b"
				},
				{
					"match": "^\\s*([a-zA-Z_][a-zA-Z0-9_]*)\\s*:",
					"captures": {
						"1": {"name": "entity.name.label.decorate"}
					}
				},
				{
					"match": "(?:(\")([^\"]+)(\")|([A-Za-z0-9_][A-Za-z0-9_]{0,7}))\\s+(?:(\")([^\"]+)(\")|([A-Za-z0-9\\[\\]\\\\]+))\\s+(?:(-?[0-9]+)|([Rr][Aa][Nn][Dd][Oo][Mm])\\s*\\(\\s*(-?[0-9]+)\\s*,\\s*(-?[0-9]+)\\s*\\))",
					"captures": {
						"1": {"name": "punctuation.definition.string.begin.decorate"},
						"2": {"name": "string.sprite.decorate"},
						"3": {"name": "punctuation.definition.string.end.decorate"},
						"4": {"name": "string.sprite.decorate"},
						"5": {"name": "punctuation.definition.string.begin.decorate"},
						"6": {"name": "constant.character.sprite-frame.decorate"},
						"7": {"name": "punctuation.definition.string.end.decorate"},
						"8": {"name": "constant.character.sprite-frame.decorate"},
						"9": {"name": "constant.numeric.decorate"},
						"10": {"name": "entity.name.function.decorate"},
						"11": {"name": "constant.numeric.decorate"},
						"12": {"name": "constant.numeric.decorate"}
					}
				},
			{
				"match": "(?i)\\b(Bright|Fast|Slow|NoDelay|CanRaise|Offset|Light)\\b",
				"name": "storage.type.decorate"
			},
			{
				"match": "(?i)\\b(Loop|Stop|Wait|Fail)\\b",
				"name": "keyword.control.decorate"
			},
				{
					"match": "(?i)\\b(Goto)\\b\\s+([A-Za-z0-9_']+(?:\\.[A-Za-z0-9_']+)*)(?:\\s*(\\+)\\s*([0-9]+))?",
					"captures": {
						"1": {"name": "keyword.control.decorate"},
						"2": {"name": "entity.name.label.decorate"},
						"3": {"name": "keyword.operator.decorate"},
						"4": {"name": "constant.numeric.decorate"}
					}
				}
			]
		},
		"actor-properties": {
			"patterns": [
				{
					"match": "(?i)\\b(?:Scale|Health|GibHealth|WoundHealth|Reactiontime|Radius|Height|Mass|RenderStyle|Alpha|MinMissileChance|MeleeRange|MaxDropoffHeight|MaxStepHeight|BounceFactor|WallBounceFactor|BounceCount|FloatSpeed|FloatBobPhase|Gravity|DamageFactor|PushFactor|WeaveIndexXY|WeaveIndexZ|DesignatedTeam|PainType|DeathType|Accuracy|Activation|ActiveSound|Args|AttackSound|BloodColor|BloodType|BounceSound|BounceType|BurnHeight|CameraHeight|ClearFlags|CrushPainSound|Damage|DamageType|DeathHeight|DeathSound|Decal|DefaultAlpha|DontHurtShooter|DropItem|ExplosionDamage|ExplosionRadius|FastSpeed|HitObituary|HowlSound|LimitedToTeam|MaxTargetRange|MeleeDamage|MeleeSound|MeleeThreshold|MissileHeight|MissileType|Monster|Obituary|PainChance|PainSound|PainThreshold|PoisonDamage|PoisonDamageType|Projectile|ProjectileKickback|ProjectilePassHeight|RadiusDamageFactor|SeeSound|SelfObituary|Skip_Super|Species|Speed|Stamina|StencilColor|Tag|Translation|VisibleToPlayerClass|VisibleToTeam|VSpeed|WallBounceSound|XScale|YScale|Inventory\\.Amount|Inventory\\.DefMaxAmount|Inventory\\.MaxAmount|Inventory\\.Icon|Inventory\\.PickupMessage|Inventory\\.PickupSound|Inventory\\.UseSound|Inventory\\.RespawnTics|Inventory\\.GiveQuest|Inventory\\.InterHubAmount|Inventory\\.PickupFlash|Weapon\\.AmmoType|Weapon\\.AmmoType1|Weapon\\.AmmoType2|Weapon\\.AmmoGive|Weapon\\.AmmoGive1|Weapon\\.AmmoGive2|Weapon\\.AmmoUse|Weapon\\.AmmoUse1|Weapon\\.AmmoUse2|Weapon\\.Kickback|Weapon\\.SlotNumber|Weapon\\.SisterWeapon|Weapon\\.SelectionOrder|Weapon\\.UpSound|Weapon\\.ReadySound|Weapon\\.AttackSound|Weapon\\.YAdjust|Weapon\\.BobStyle|Weapon\\.BobSpeed|Weapon\\.BobRangeX|Weapon\\.BobRangeY|Weapon\\.WeaponScaleX|Weapon\\.WeaponScaleY|Ammo\\.BackpackAmount|Ammo\\.BackpackMaxAmount|Ammo\\.DropAmount|Armor\\.SavePercent|Armor\\.SaveAmount|Armor\\.MaxSaveAmount|Health\\.LowMessage|HealthPickup\\.AutoUse|PuzzleItem\\.Number|WeaponPiece\\.Number|WeaponPiece\\.Weapon|Powerup\\.Duration|Powerup\\.Color|Powerup\\.Type|Powerup\\.Strength|Player\\.DisplayName|Player\\.JumpZ|Player\\.ViewHeight|Player\\.ForwardMove|Player\\.SideMove|Player\\.ColorRange|Player\\.SoundClass|Player\\.StartItem|Player\\.WeaponSlot|Player\\.CrouchSprite|Player\\.MaxHealth|Player\\.RunHealth|Player\\.ScoreIcon|Player\\.Portrait|Player\\.HexenArmor)\\b(?=\\s*\\()",
					"name": "storage.type.decorate"
				},
				{
					"match": "\\b(var|const)\\s+(int|float)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
					"captures": {
						"1": {"name": "storage.modifier.decorate"},
						"2": {"name": "storage.type.decorate"},
						"3": {"name": "variable.other.decorate"}
					}
				},
				{
					"match": "\\b(user_[a-zA-Z0-9_]*)\\b",
					"name": "variable.other.decorate"
				},
				{
					"match": "(?i)\\b(Args)[ \\t]+(?=-?\\d)",
					"captures": {
						"1": {"name": "storage.type.decorate"}
					}
				},
				{
					"name": "variable.other.decorate",
					"match": "(?i)\\b(x|y|z|angle|ceilingz|floorz|pitch|velx|momx|vely|momy|velz|momz|accuracy|alpha|args|damage|health|height|mass|meleerange|radius|reactiontime|scaleX|scaleY|score|speed|special|stamina|tid|tidtohate|waterlevel)\\b"
				},
				{
					"match": "\\b([a-zA-Z_][a-zA-Z0-9_.]*)[ \\t]+(?=[A-Za-z0-9\"\\(.]|-\\d)",
					"captures": {
						"1": {"name": "storage.type.decorate"}
					}
				}
			]
		},

		"keywords": {
			"patterns": [
				{
					"match": "(?i)\\b(true|false)\\b",
					"name": "constant.language.decorate"
				}
			]
		},
		"constants": {
			"patterns": [
				{
					"match": "\\b[A-Z][A-Z0-9]*[_.][A-Z][A-Z0-9_]+\\b",
					"name": "constant.language.enum.decorate"
				}
			]
		},
		"properties": {
			"patterns": [
				{
					"match": "[A-Za-z_][A-Za-z0-9_.]*(?=[ \\t])",
					"name": "variable.other.property.decorate"
				}
			]
		},
		"flags": {
			"patterns": [
				{
					"match": "(?i)\\b(Monster|Projectile)\\b",
					"name": "constant.language.flag.decorate"
				},
				{
					"match": "(?<![^\\s])([+\\-])([A-Za-z_][A-Za-z0-9_.]*)\\b(?!\\s*\\()",
					"captures": {
						"1": {"name": "keyword.operator.flag.decorate"},
						"2": {"name": "constant.language.flag.decorate"}
					}
				}
			]
		},
		"action-functions": {
			"patterns": [
				{
					"match": "\\bA_[a-zA-Z0-9_]*\\b",
					"name": "entity.name.function.decorate"
				},
				{
					"match": "(?i)\\b(abs|cos|sin|sqrt|random|random2|frandom|ACS_ExecuteWithResult|ACS_NamedExecuteWithResult|CallACS)\\b(?=\\s*\\()",
					"name": "entity.name.function.decorate"
				},
				{
					"match": "\\w+(?=\\()",
					"name": "entity.name.function.decorate"
				}

			]
		},
		"strings": {
			"patterns": [
				{
					"name": "string.quoted.double.decorate",
					"begin": "\"",
					"end": "\"",
					"patterns": [
						{
							"name": "constant.character.escape.color.decorate",
							"match": "\\\\c(?:\\[[^\\]]*\\]|[A-Za-z-])"
						},
						{
							"name": "constant.character.escape.decorate",
							"match": "\\\\."
						}
					]
				}
			]
		},
		"operators": {
			"patterns": [
				{
					"match": ",",
					"name": "punctuation.separator.decorate"
				},
				{
					"match": "[=+\\-*/%&|^~<>!]+",
					"name": "keyword.operator.arithmetic.decorate"
				}
			]
		},
		"numbers": {
			"patterns": [
				{
					"match": "(?<![A-Za-z0-9_])0[xX][0-9a-fA-F]+[uUlL]?(?![A-Za-z0-9_])",
					"name": "constant.numeric.hex.decorate"
				},
				{
					"match": "(?<![A-Za-z0-9_])-?(?:[0-9]+\\.[0-9]*|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?[fFlL]?(?![A-Za-z0-9_])",
					"name": "constant.numeric.float.decorate"
				},
				{
					"match": "(?<![A-Za-z0-9_])-?[0-9]+[eE][+-]?[0-9]+[fFlL]?(?![A-Za-z0-9_])",
					"name": "constant.numeric.float.decorate"
				},
				{
					"match": "(?<![A-Za-z0-9_])-?[0-9]+[uUlL]?(?![A-Za-z0-9_])",
					"name": "constant.numeric.integer.decorate"
				}
			]
		}
	},
	"scopeName": "source.decorate"
}
