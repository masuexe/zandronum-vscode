{
    "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
    "name": "SBARINFO",
    "patterns": [
        { "include": "#comments" },
        { "include": "#strings" },
        { "include": "#statusbar-header" },
        { "include": "#flow-control" },
        { "include": "#draw-commands" },
        { "include": "#control-commands" },
        { "include": "#block-keywords" },
        { "include": "#constants" },
        { "include": "#numbers" },
        { "include": "#braces" }
    ],
    "repository": {
        "comments": {
            "patterns": [
                { "name": "comment.line.double-slash.sbarinfo", "match": "//.*$" },
                { "name": "comment.block.sbarinfo", "begin": "/\\*", "end": "\\*/" }
            ]
        },
        "strings": {
            "patterns": [
                {
                    "name": "string.quoted.double.sbarinfo",
                    "begin": "\"",
                    "end": "\"",
                    "patterns": [
                        { "name": "constant.character.escape.color.sbarinfo", "match": "\\\\c(?:\\[[^\\]]*\\]|[A-Za-z-])" },
                        { "name": "constant.character.escape.sbarinfo", "match": "\\\\." }
                    ]
                }
            ]
        },
        "statusbar-header": {
            "patterns": [
                {
                    "match": "(?i)\\b(statusbar)\\s+(normal|fullscreen|fullscreenoffsets|automap|inventory|inventoryfullscreen|popuplog|popupkeys|popupstatus)\\b",
                    "captures": {
                        "1": { "name": "keyword.declaration.sbarinfo" },
                        "2": { "name": "constant.language.statusbartype.sbarinfo" }
                    }
                }
            ]
        },
        "flow-control": {
            "patterns": [
                {
                    "comment": "SBarInfoCommandFlowControl from Zandronum sbarinfo_commands.cpp SBarInfoCommandNames[] (+ else / not)",
                    "match": "(?i)\\b(gamemode|playerclass|playertype|aspectratio|isselected|usesammo|usessecondaryammo|hasweaponpiece|inventorybarnotvisible|weaponammo|ininventory|alpha|ifhealth|ifspectator|ifspying|else|not)\\b",
                    "name": "keyword.control.conditional.sbarinfo"
                }
            ]
        },
        "draw-commands": {
            "patterns": [
                { "match": "(?i)\\b(drawimage|drawmugshot|drawnumber|drawbar|drawswitchableimage|drawstring|drawgem|drawshader|drawkeybar|drawselectedinventory|drawinventorybar)\\b", "name": "support.function.draw.sbarinfo" }
            ]
        },
        "control-commands": {
            "patterns": [
                { "match": "(?i)\\b(armor|ammo|ammo1|ammo2|base|bottom|center|centerbottom|completborder|createpopup|createsmademargin|dontusesizedefaultfontcolor|forcescaled|fullscreen|fullscreenoffsets|height|horizontal|interpolatehealth|lowhealth|lowhealthvalue|lowerhealthcap|monospaceimages|nobar|nointerpolatehealth|nointerpolatearmor|onpause|popup|range|row|rows|resolution|showpopup|spacing|stretchtoscreen|top|usesmedmargin|vertical|weaponicon|webdings)\\b", "name": "keyword.control.sbarinfo" }
            ]
        },
        "block-keywords": {
            "patterns": [
                { "match": "(?i)\\b(statusbar)\\b", "name": "keyword.declaration.sbarinfo" }
            ]
        },
        "constants": {
            "patterns": [
                { "match": "(?i)\\b(normal|fullscreen|fullscreenoffsets|automap|inventory|inventoryfullscreen|popuplog|popupkeys|popupstatus)\\b", "name": "constant.language.statusbartype.sbarinfo" },
                { "match": "(?i)\\b(mugshot|default|hidden|indexfont|newline|string|int|smallfont|bigfont|confont|interpolate|not_in_both|in_both|overlay|left|right|none|singleplayer|cooperative|deathmatch|teamgame)\\b", "name": "constant.language.sbarinfo" }
            ]
        },
        "numbers": {
            "patterns": [
                { "match": "-?\\b[0-9]+\\.[0-9]*\\b", "name": "constant.numeric.float.sbarinfo" },
                { "match": "-?\\b[0-9]+\\b", "name": "constant.numeric.integer.sbarinfo" },
                { "match": "\\b0x[0-9a-fA-F]+\\b", "name": "constant.numeric.hex.sbarinfo" }
            ]
        },
        "braces": {
            "patterns": [
                { "match": "\\{", "name": "punctuation.section.block.begin.sbarinfo" },
                { "match": "\\}", "name": "punctuation.section.block.end.sbarinfo" }
            ]
        }
    },
    "scopeName": "source.sbarinfo"
}
